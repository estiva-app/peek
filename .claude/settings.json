      "Bash(npx tsc:*)",
      "Bash(npm run:*)",
      "Bash(npm uninstall:*)",
      "mcp__figma__get_design_context",
      "mcp__figma__search_design_system",
      "mcp__figma__get_screenshot",
      "Bash(npx vite:*)",
      "Bash(node -e ':*)",
      "Bash(node -e \"require\\('./node_modules/@tiptap/starter-kit/dist/index.js'\\)\")",
      "Bash(python -c \"import sys,json; d=json.load\\(sys.stdin\\); print\\(d.get\\('version'\\)\\); print\\(list\\(d.get\\('exports',{}\\).keys\\(\\)\\)[:5]\\)\")",
      "Bash(node -e \"const p=require\\('./node_modules/@tiptap/starter-kit/package.json'\\); console.log\\(p.version, Object.keys\\(p.exports||{}\\).slice\\(0,5\\)\\)\")",
      "Bash(node -e \"const p=require\\('./node_modules/@tiptap/react/package.json'\\); console.log\\(p.version, p.peerDependencies\\)\")",
      "Bash(node -e \"const p=require\\('./node_modules/@tiptap/starter-kit/package.json'\\); console.log\\(JSON.stringify\\(p.peerDependencies\\)\\)\")",
      "Bash(node -e \"const p=require\\('./node_modules/@tiptap/starter-kit/package.json'\\); console.log\\(JSON.stringify\\(p.dependencies\\)\\)\")",
      "Bash(node -e \"const s=require\\('./node_modules/@tiptap/starter-kit/dist/index.js'\\); console.log\\(typeof s.default, typeof s.StarterKit\\)\")",
      "Bash(node -e \"const sk = require\\('@tiptap/starter-kit'\\); console.log\\(Object.keys\\(sk.default?.extensions || sk.StarterKit?.extensions || {}\\)\\)\")",
      "Bash(node -e \"const sk = require\\('@tiptap/starter-kit'\\); const e = sk.StarterKit || sk.default; console.log\\(typeof e\\)\")",
      "Bash(python -c \"import sys,json; data=json.load\\(sys.stdin\\); [print\\(item.get\\('text',''\\)[:3000]\\) for item in data if item.get\\('type'\\)=='text']\")",
      "Bash(python3 -c \" import sys, json data = json.load\\(sys.stdin\\) for item in data: t = item.get\\('type',''\\) text = item.get\\('text',''\\) if t == 'text' and len\\(text\\) > 100: print\\(text[:5000]\\) print\\('---BREAK---'\\) \")",
      "Bash(python3 -c ':*)",
      "Bash(npm run ui:find *)",
      "Bash(npm --prefix * run ui:find *)",
      "PowerShell(npm run ui:find *)",
      "PowerShell(npm --prefix * run ui:find *)"
