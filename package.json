{
  "name": "peek-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:tokens": "eslint --config eslint.tokens.config.js .",
    "lint:rules": "eslint --config eslint.gates.config.js .",
    "postlint:rules": "estiva-gates count --repo peek",
    "gates:status": "estiva-gates status",
    "ui:find": "estiva-ui find --repo peek --also ship=../ship/web",
    "registry": "estiva-ui build --repo peek",
    "registry:check": "estiva-ui check --repo peek",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@estiva-app/identity": "^0.2.1",
    "@estiva-app/interop": "^0.23.0",
    "@estiva-app/platform": "^0.1.0",
    "@estiva-app/protocol": "^0.22.0",
    "@estiva-app/ui": "^0.23.0",
    "@noble/curves": "^1.9.2",
    "@noble/hashes": "^1.8.0",
    "@tabler/icons-react": "^3.41.1",
    "@tiptap/extension-link": "^3.22.1",
    "@tiptap/extension-mention": "^3.22.1",
    "@tiptap/pm": "^3.22.1",
    "@tiptap/react": "^3.22.1",
    "@tiptap/starter-kit": "^3.22.1",
    "@tiptap/suggestion": "^3.22.1",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "convex-test": "^0.0.55",
    "eslint": "^9.39.4",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.61.1",
    "postcss": "^8.5.8",
    "storybook": "^10.4.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.5"
  }
}
